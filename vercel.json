{
  "installCommand": "bun install",
  "buildCommand": "npm run build",
  "env": {
    "NEXT_PUBLIC_SKIP_DATABASE_MIGRATIONS": "true"
  },
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },

    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 18 * * 1"
    },
    {
      "path": "/api/cron/compute-trade-data",
      "schedule": "0 19 * * 0"
    },
    {
      "path": "/api/cron/investing?lang=fr&db=true",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/investing?lang=en&db=true",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/renewal-notice",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/renew-tradovate-token",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/chat-retention",
      "schedule": "0 3 * * *"
    }
  ]
}
