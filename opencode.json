{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "qunt-edge": {
      "type": "remote",
      "url": "https://qunt-edge.vercel.app/api/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:QUNT_MCP_API_KEY}"
      }
    },
    "qunt-edge-public": {
      "type": "remote",
      "url": "https://qunt-edge.vercel.app/api/mcp/public",
      "enabled": true,
      "oauth": false
    }
  }
}