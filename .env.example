# ===========================================
# Qunt Edge Environment Configuration Template
# Synced from Vercel environment keys + project defaults
# ===========================================

# Database
# DATABASE_URL: pooled runtime URL (Supabase transaction pooler, typically port 6543)
# DIRECT_URL: direct URL for migrations (typically port 5432)
DATABASE_URL=your_database_url_here
DIRECT_URL=your_direct_database_url_here
DATABASE_HOST=your_database_host_here
POSTGRES_PRISMA_URL=your_postgres_prisma_url_here

# Prisma / Pool tuning
PG_POOL_MAX=20
PG_POOL_MIN=5
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECT_TIMEOUT_MS=10000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_BASE_URL=https://your-openai-compatible-endpoint
AI_MODEL_DEFAULT=your_default_model_here
AI_MODEL=your_default_model_alias_here
AI_MODEL_CHAT=your_chat_model_here
AI_MODEL_SUPPORT=your_support_model_here
AI_MODEL_EDITOR=your_editor_model_here
AI_MODEL_MAPPINGS=your_mappings_model_here
AI_MODEL_FORMAT_TRADES=your_format_trades_model_here
AI_MODEL_ANALYSIS=your_analysis_model_here
AI_MODEL_SEARCH=your_search_model_here
AI_TIMEOUT_MS=60000
AI_MAX_STEPS=10
AI_LOG_SAMPLE_RATE=0.25
AI_ROUTER_ENABLED=true
AI_ROUTER_PROVIDER_ORDER=openrouter
AI_ROUTER_MAX_PRICE_INPUT=0.05
AI_ROUTER_MAX_PRICE_OUTPUT=0.05
AI_ROUTER_BYOK_FREE_MODELS=
# Legacy router aliases kept for backwards compatibility
AI_ROUTER_MODEL_FREE=openrouter/free
AI_ROUTER_MODEL_AUTO=openrouter/auto
AI_ROUTER_MODEL_LIQUID=Liquid/lfm2-8b-a1b
AI_ROUTER_LIQUID_MODEL=Liquid/lfm2-8b-a1b

# Auth / OAuth
NEXT_PUBLIC_DISCORD_CONFIGURED=true
DISCORD_ID=your_discord_client_id_here
DISCORD_SECRET=your_discord_client_secret_here
NEXT_PUBLIC_GOOGLE_CONFIGURED=true
REDIRECT_URL=http://localhost:3000/api/auth/callback
TRADOVATE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Admin access control
ADMIN_USER_ID=your_admin_user_id_here
ALLOWED_ADMIN_USER_ID=comma,separated,user_ids_here
ADMIN_EMAIL_DOMAINS=yourcompany.com,anotherdomain.com

# Security
ENCRYPTION_KEY=your_encryption_key_here
TOKEN_CRYPTO_KEY=your_32_plus_char_token_crypto_key_here
CRON_SECRET=your_cron_secret_here
VERCEL_CRON_SECRET=your_vercel_cron_secret_here
UNSUBSCRIBE_TOKEN_SECRET=your_unsubscribe_token_secret_here
WIDGET_MESSAGE_BUS_SECRET=your_widget_message_bus_secret_here
CSP_ENABLED=true
CSP_REPORT_ONLY=false
CSP_STRICT_MODE=true

# Email / Support
RESEND_API_KEY=your_resend_api_key_here
SUPPORT_TEAM_EMAIL=support@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# Marketing / public app URLs
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
NEXT_PUBLIC_BASE_URL=https://your-production-domain.com
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_DISCORD_INVITATION=https://discord.gg/your-invite-code
NEXT_PUBLIC_REPO_OWNER=your_repo_owner_here
NEXT_PUBLIC_REPO_NAME=your_repo_name_here
NEXT_PUBLIC_CACHE_DEBUG=false
NEXT_PUBLIC_ENABLE_PUBLIC_MOTION=true
NEXT_PUBLIC_ENABLE_SW=true
NEXT_PUBLIC_SW_ENABLED=true

# Tutorials / content
NEXT_PUBLIC_RITHMIC_PERFORMANCE_TUTORIAL_VIDEO=your_video_url_here
NEXT_PUBLIC_RITHMIC_ORDER_TUTORIAL_VIDEO=your_video_url_here
NEXT_PUBLIC_NINJATRADER_PERFORMANCE_TUTORIAL_VIDEO=your_video_url_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# Whop
WHOP_API_KEY=your_whop_api_key_here
WHOP_COMPANY_ID=your_whop_company_id_here
WHOP_CLIENT_SECRET=your_whop_client_secret_here
WHOP_WEBHOOK_SECRET=your_whop_webhook_secret_here
NEXT_PUBLIC_WHOP_APP_ID=your_whop_app_id_here
NEXT_PUBLIC_WHOP_PRODUCT_URL=https://whop.com/your-product-url
NEXT_PUBLIC_WHOP_MONTHLY_PLAN_ID=your_monthly_plan_id_here
NEXT_PUBLIC_WHOP_6MONTH_PLAN_ID=your_6month_plan_id_here
NEXT_PUBLIC_WHOP_YEARLY_PLAN_ID=your_yearly_plan_id_here
NEXT_PUBLIC_WHOP_LIFETIME_PLAN_ID=your_lifetime_plan_id_here
NEXT_PUBLIC_WHOP_FREE_PLAN_ID=your_free_plan_id_here
NEXT_PUBLIC_WHOP_TEAM_PLAN_ID=your_team_plan_id_here

# Redis cache
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Performance rollout
NEXT_PUBLIC_ENABLE_SKELETON_LOADING=false
NEXT_PUBLIC_ENABLE_DEFERRED_COMPUTATIONS=false
NEXT_PUBLIC_ENABLE_LAZY_LOADING=false
NEXT_PUBLIC_ENABLE_QUERY_CACHING=false
NEXT_PUBLIC_PERF_ROLLOUT_PCT=0
NEXT_PUBLIC_EMERGENCY_ROLLBACK=false

# MT5 auto-import
MT5_API_TOKEN=your_mt5_api_token_here
IMPORT_WORKERS=2
MT5_TERMINALS_PER_WORKER=5
SYNC_INTERVAL_ACTIVE=300
SYNC_INTERVAL_NORMAL=1800
SYNC_INTERVAL_INACTIVE=14400

# Integrations / misc
GITHUB_TOKEN=your_github_token_here
DATABENTO_API_KEY=your_databento_api_key_here
LOG_LEVEL=info
