# =============================================================================
# Qunt Edge — Production Environment Configuration
# =============================================================================
# AUTO-GENERATED from codebase analysis. Every variable below is referenced
# somewhere in the source code. Variables marked REQUIRED will crash the app
# if missing in production.
#
# Copy this file to .env.local for development or set in Vercel env vars.
# =============================================================================

# ─── Environment ──────────────────────────────────────────────────────────
# REQUIRED for production builds. Next.js automatically sets this in Vercel.
NODE_ENV=development

# Enable Next.js 'use cache' directives (set to false to disable all caching)
NEXT_CACHE_COMPONENTS=true

# ─── Database (PostgreSQL / Supabase) ─────────────────────────────────────
# REQUIRED: Pooled URL for runtime queries (Supabase transaction pooler,
# typically port 6543). Must be set in production.
DATABASE_URL=postgresql://user:password@host:6543/db?pgbouncer=true

# REQUIRED: Direct URL for Prisma migrations (port 5432, no PgBouncer).
DIRECT_URL=postgresql://user:password@host:5432/db

# Optional fallbacks — Prisma checks these in order:
# POSTGRES_PRISMA_URL > POSTGRES_URL > DATABASE_URL > DIRECT_URL > POSTGRES_URL_NON_POOLING
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Pool tuning (serverless-safe defaults)
PG_POOL_MAX=5
PG_POOL_MIN=0
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECT_TIMEOUT_MS=10000

# SSL — Supabase Neon typically requires SSL=true
PGSSL_ENABLE=true
PGSSL_REJECT_UNAUTHORIZED=false
PG_SSL_MODE=

# Skip DB migrations during build (set true for Vercel deploys)
NEXT_PUBLIC_SKIP_DATABASE_MIGRATIONS=true

# Test database (optional)
DATABASE_URL_TEST=

# Health check alert threshold (ms). 0 to disable.
DB_LATENCY_ALERT_MS=1000

# ─── Supabase Auth ────────────────────────────────────────────────────────
# REQUIRED: Supabase project URL and anon key for client-side auth.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Admin server client — used in server actions and admin pages for
# privileged operations. Keep these server-side only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Legacy aliases (still read by auth server code for fallback)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Admin Access ─────────────────────────────────────────────────────────
# REQUIRED: Comma-separated Supabase user IDs that have admin panel access.
ALLOWED_ADMIN_USER_ID=user_id_1,user_id_2

# Legacy single admin ID (still checked in proxy.ts and authz.ts as fallback)
ADMIN_USER_ID=your_admin_user_id_here

# Admin email domains for additional admin grant
ADMIN_EMAIL_DOMAINS=yourdomain.com

# ─── Auth Security ────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOCKOUT_ENABLED=true
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_WINDOW_MS=900000       # 15 minutes
AUTH_LOCKOUT_DURATION_1_MS=300000   # 1st offense: 5 min lockout
AUTH_LOCKOUT_DURATION_2_MS=900000   # 2nd offense: 15 min lockout
AUTH_LOCKOUT_DURATION_3_MS=3600000  # 3rd+ offense: 60 min lockout
AUTH_MFA_ENFORCEMENT=false          # 'all' | 'email' | false
AUTH_ERROR_OBFUSCATION=true          # Hide detailed auth error messages
AUTH_OAUTH_STATE_TTL_MS=600000      # 10 min OAuth state TTL

# ─── MCP OAuth (Supabase OAuth 2.1 Server) ───────────────────────────────
# REQUIRED for MCP OAuth in Cursor/Claude: enable OAuth 2.1 Server in Supabase
# Dashboard → Authentication → OAuth Server. Set Authorization Path to match:
MCP_OAUTH_CONSENT_PATH=/oauth/consent
# Supabase Site URL must be your app origin (e.g. https://qunt-edge.vercel.app).
# Enable dynamic client registration if your MCP client requires it.
# Cursor (recommended): use /api/mcp/key with a qunt_usr_* key — OAuth discovery is ignored by Cursor.
# QUNT_MCP_API_KEY=qunt_usr_your_key_here

# ─── Security ─────────────────────────────────────────────────────────────
# REQUIRED: Encryption key for payment security (whop webhook secret).
ENCRYPTION_KEY=your_32_plus_char_encryption_key_here
WHOP_WEBHOOK_SECRET=your_whop_webhook_secret_here

# Token crypto for broker credential encryption (min 32 chars)
TOKEN_CRYPTO_KEY=your_32_plus_char_token_crypto_key_here
TOKEN_CRYPTO_KEY_VERSION=v1

# Unsubscribe token signing (min 32 chars)
UNSUBSCRIBE_TOKEN_SECRET=your_32_plus_char_unsubscribe_secret_here

# Content Security Policy
CSP_ENABLED=true
CSP_REPORT_ONLY=false            # Set true to test CSP without blocking
CSP_STRICT_MODE=true

# Debug endpoint (only available in dev unless explicitly enabled)
ENABLE_DEBUG_ENDPOINT=false

# Health/ready endpoint details (must be false in production)
HEALTH_DETAILS_PUBLIC=false
READY_DETAILS_PUBLIC=false

# ─── Cron Jobs ────────────────────────────────────────────────────────────
# REQUIRED: Used to authenticate internal cron job API calls.
CRON_SECRET=your_cron_secret_here
VERCEL_CRON_SECRET=your_vercel_cron_secret_here

# ─── AI / Provider (Standardized) ──────────────────────────────────────────
# STANDARDIZED: Single credential for your chosen Vercel AI SDK provider.
# Supports OpenRouter, OpenAI, DeepSeek, Anthropic, Ollama, LM Studio, etc.
AI_PROVIDER_API_KEY=sk-or-v1-your_provider_key_here

# STANDARDIZED: Custom proxy, regional endpoint, or compatibility layer.
# Examples: https://openrouter.ai/api/v1, http://localhost:11434/v1
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1

# STANDARDIZED: Main fallback engine for standard chats and content processing.
AI_DEFAULT_MODEL=glm-4.7-flash

# STANDARDIZED: Model for resource-heavy data audits and trading analytics.
AI_ANALYTICS_MODEL=gpt-4o-mini

# REQUIRED: OpenAI API key for audio transcription (separate service).
OPENAI_API_KEY=sk-your_openai_api_key_here

# ─── AI / Legacy (backward compatible — will be removed in future) ─────────
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here       # deprecated → use AI_PROVIDER_API_KEY
AI_BASE_URL=https://openrouter.ai/api/v1                   # deprecated → use AI_PROVIDER_BASE_URL
AI_MODEL_DEFAULT=glm-4.7-flash                             # deprecated → use AI_DEFAULT_MODEL
AI_MODEL=glm-4.7-flash                                     # legacy alias (deprecated)
AI_MODEL_ANALYSIS=                                          # deprecated → use AI_ANALYTICS_MODEL

# ─── AI / Per-Feature Model Overrides ─────────────────────────────────────
# These override AI_DEFAULT_MODEL for specific features.
AI_MODEL_CHAT=
AI_MODEL_SUPPORT=
AI_MODEL_EDITOR=
AI_MODEL_MAPPINGS=
AI_MODEL_FORMAT_TRADES=
AI_MODEL_SEARCH=

# Model for web-search capable AI support
AI_SUPPORT_WEBSEARCH_MODEL=

# AI behaviour
AI_TIMEOUT_MS=60000
AI_MAX_STEPS=10
AI_LOG_SAMPLE_RATE=0.25          # 0.0–1.0 — fraction of AI calls logged

# Model for audio transcription (defaults to whisper-1)
AI_TRANSCRIBE_MODEL=whisper-1

# Base URL for audio transcription (defaults to https://api.z.ai/api/paas/v4)
AI_TRANSCRIBE_BASE_URL=https://api.z.ai/api/paas/v4

# ─── Email / Resend ───────────────────────────────────────────────────────
# REQUIRED: Resend API key for transactional emails.
RESEND_API_KEY=re_your_resend_api_key_here

# Sender and reply-to addresses
SUPPORT_EMAIL=support@qunt-edge.com
SUPPORT_TEAM_EMAIL=support@qunt-edge.com
WELCOME_REPLY_TO=team@qunt-edge.com
WELCOME_WEBHOOK_SECRET=your_welcome_webhook_secret_here
WEEKLY_SUMMARY_REPLY_TO=team@qunt-edge.com
RENEWAL_NOTICE_REPLY_TO=team@qunt-edge.com
TEAM_INVITE_FROM=Qunt Edge Team <team@qunt-edge.com>
TEAM_INVITE_REPLY_TO=team@qunt-edge.com

# ─── Payments — Whop ──────────────────────────────────────────────────────
# REQUIRED: Whop API credentials for subscription management.
WHOP_API_KEY=your_whop_api_key_here
WHOP_COMPANY_ID=your_whop_company_id_here
WHOP_CLIENT_SECRET=your_whop_client_secret_here
NEXT_PUBLIC_WHOP_APP_ID=your_whop_app_id_here
# WHOP_WEBHOOK_SECRET is listed under Security above

# REQUIRED: Whop plan IDs — map to your pricing tiers on Whop.
NEXT_PUBLIC_WHOP_MONTHLY_PLAN_ID=plan_your_monthly_plan_id
NEXT_PUBLIC_WHOP_6MONTH_PLAN_ID=plan_your_6month_plan_id
NEXT_PUBLIC_WHOP_YEARLY_PLAN_ID=plan_your_yearly_plan_id
NEXT_PUBLIC_WHOP_LIFETIME_PLAN_ID=plan_your_lifetime_plan_id
NEXT_PUBLIC_WHOP_TEAM_PLAN_ID=plan_your_team_plan_id

# ─── Redis / Rate Limiting ────────────────────────────────────────────────
# Local Redis for development
REDIS_URL=redis://localhost:6379

# Upstash Redis for production (serverless-compatible HTTP API)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# When true: all rate-limited routes return 429 if Upstash unavailable
RATE_LIMIT_STRICT_MODE=false

# ─── Integrations — Tradovate ─────────────────────────────────────────────
# OAuth2 credentials for Tradovate trade sync.
TRADOVATE_CLIENT_ID=your_tradovate_client_id_here
TRADOVATE_CLIENT_SECRET=your_tradovate_client_secret_here
TRADOVATE_REDIRECT_URI=https://qunt-edge.vercel.app/api/auth/callback
TRADOVATE_DEBUG=false
TRADOVATE_TOKEN_ENCRYPTION_ENABLED=true

# ─── Integrations — DxFeed ────────────────────────────────────────────────
# Market data provider for tick values and financial events.
DXFEED_AUTH_URL=https://your-dxfeed-auth-url.com
DXFEED_PLATFORM_KEY=your_dxfeed_platform_key_here
DXFEED_ENVIRONMENT=0               # 0=production, 1=development
DXFEED_HISTORY_LOOKBACK_DAYS=364
DXFEED_DEBUG=false

# ─── Integrations — Rithmic ───────────────────────────────────────────────
# Rithmic EdgeProX API host for trade sync.
NEXT_PUBLIC_RITHMIC_API_URL=your-rithmic-api-host.com

# ─── Integrations — Databento ─────────────────────────────────────────────
# Market data provider for historical data.
DATABENTO_API_KEY=your_databento_api_key_here

# ─── Integrations — YouTube ───────────────────────────────────────────────
# YouTube Data API key for fetching video metadata in the admin weekly recap.
YOUTUBE_API_KEY=your_youtube_api_key_here

# ─── Public URLs ──────────────────────────────────────────────────────────
# REQUIRED: Your production app URL. Used in emails, OG images, AI headers.
NEXT_PUBLIC_APP_URL=https://qunt-edge.vercel.app
NEXT_PUBLIC_SITE_URL=https://qunt-edge.vercel.app

# Vercel auto-assigned URLs
NEXT_PUBLIC_VERCEL_URL=https://qunt-edge.vercel.app
VERCEL_URL=
VERCEL_ENV=production
VERCEL=1                             # Set to 1 when deploying on Vercel

# CDN URL for optimized image hosting (empty = use same origin)
NEXT_PUBLIC_CDN_URL=

# Community link
NEXT_PUBLIC_DISCORD_INVITATION=https://discord.gg/your-invite-code

# ─── Tutorial Videos (optional) ──────────────────────────────────────────
# YouTube video IDs for onboarding walkthroughs.
# Falls back: NEXT_PUBLIC_ONBOARDING_VIDEO_ID_EN > NEXT_PUBLIC_ONBOARDING_VIDEO_ID
NEXT_PUBLIC_ONBOARDING_VIDEO_ID=
NEXT_PUBLIC_ONBOARDING_VIDEO_ID_EN=
NEXT_PUBLIC_ONBOARDING_VIDEO_ID_FR=

# YouTube video URLs for import platform tutorials (shown in import UI).
# These are URLs, not IDs.
NEXT_PUBLIC_RITHMIC_SYNC_TUTORIAL_VIDEO=
NEXT_PUBLIC_RITHMIC_PERFORMANCE_TUTORIAL_VIDEO=
NEXT_PUBLIC_RITHMIC_ORDER_TUTORIAL_VIDEO=
NEXT_PUBLIC_NINJATRADER_PERFORMANCE_TUTORIAL_VIDEO=
NEXT_PUBLIC_PDF_IMPORT_TUTORIAL_VIDEO=
NEXT_PUBLIC_QUANTOWER_TUTORIAL_VIDEO=
NEXT_PUBLIC_THOR_SYNC_TUTORIAL_VIDEO=
NEXT_PUBLIC_TRADEOVATE_TUTORIAL_VIDEO=
NEXT_PUBLIC_TRADOVATE_SYNC_TUTORIAL_VIDEO=
NEXT_PUBLIC_ATAS_TUTORIAL_VIDEO=

# ─── Feature Flags ────────────────────────────────────────────────────────
# Performance rollout (staged — see lib/feature-flags.ts)
NEXT_PUBLIC_ENABLE_SKELETON_LOADING=false
NEXT_PUBLIC_ENABLE_DEFERRED_COMPUTATIONS=false
NEXT_PUBLIC_ENABLE_LAZY_LOADING=false
NEXT_PUBLIC_ENABLE_QUERY_CACHING=false
NEXT_PUBLIC_ENABLE_DEV_MOCK_TRADES=false
NEXT_PUBLIC_PERF_ROLLOUT_PCT=0
NEXT_PUBLIC_EMERGENCY_ROLLBACK=false

# Server-side dashboard bootstrap (reduces client load)
NEXT_PUBLIC_SERVER_DASHBOARD_BOOTSTRAP=false
NEXT_PUBLIC_SERVER_DASHBOARD_BOOTSTRAP_PCT=0

# Theme enforcement
NEXT_PUBLIC_DARK_ONLY_SURFACE_ENFORCEMENT=true

# UI system
NEXT_PUBLIC_UI_V2_ENABLED=true
NEXT_PUBLIC_CACHE_DEBUG=false
NEXT_PUBLIC_CACHE_REVALIDATE=
NEXT_PUBLIC_DISABLE_SERVICE_WORKERS=false
NEXT_PUBLIC_SW_ENABLED=true

# ─── Build & CI ───────────────────────────────────────────────────────────
# CPU count for production builds
NEXT_BUILD_CPUS=1
# Build retry settings (robust-next-build.mjs)
NEXT_BUILD_MAX_ATTEMPTS=4
NEXT_BUILD_RETRY_DELAY_MS=250
# Output mode
NEXT_STANDALONE=false

# Budget thresholds (scripts/*.mjs)
# Max warnings for eslint (default: 1546)
LINT_WARNING_MAX=1546
# Route bundle size limits in KB (defaults: general=300, home=80, dashboard=80)
ROUTE_BUDGET_KB=300
HOME_ROUTE_BUDGET_KB=80
DASHBOARD_ROUTE_BUDGET_KB=80

# Next.js internal phase (set automatically by Next.js during build)
NEXT_PHASE=

# Prisma migration mode during build
PRISMA_GENERATE_STRICT=false
SYNC_STACK_APPLY_MIGRATIONS=false
SYNC_STACK_BASELINE=false

# ─── Logging & Monitoring ────────────────────────────────────────────────
LOG_LEVEL=info                     # debug | info | warn | error
ERROR_ALERT_THRESHOLD=20           # Errors per window before alert
ERROR_ALERT_WINDOW_MS=300000       # Alert window (5 min)

# ─── Testing ──────────────────────────────────────────────────────────────
RUN_PAYMENT_INTEGRATION_TESTS=false
# Perf baseline testing
PERF_BASELINE_ROUTES=
PERF_BASELINE_RUNS=
PERF_BASE_URL=
PERF_DASHBOARD_AUTH_COOKIE=
PERF_DASHBOARD_AUTH_MAX_MS=
PERF_DASHBOARD_PATH=
PERF_DASHBOARD_REDIRECT_MAX_MS=
PERF_HEADER_STRICT=
PERF_ROUTES=
# Smoke tests
SMOKE_BASE_URL=
SMOKE_TIMEOUT_MS=
# Lighthouse
LIGHTHOUSE_CHROME_FLAGS=
LIGHTHOUSE_DESKTOP_LCP_MAX_MS=
LIGHTHOUSE_DESKTOP_MIN=
LIGHTHOUSE_DESKTOP_TBT_MAX_MS=
LIGHTHOUSE_MOBILE_CLS_MAX=
LIGHTHOUSE_MOBILE_LCP_MAX_MS=
LIGHTHOUSE_MOBILE_MIN=
LIGHTHOUSE_TBT_MAX_MS=

# ─── Prisma Internals (rarely needed) ────────────────────────────────────
PRISMA_DISABLE_WARNINGS=
PRISMA_CLIENT_GET_TIME=
TEST_CLIENT_ENGINE_REMOTE_EXECUTOR=
TYPECHECK_MAX_ATTEMPTS=
