# ===========================================
# Qunt Edge Environment Configuration Template
# Synced from live Vercel project envs (final-qunt-edge) + runtime defaults
# ===========================================

# Environment
NODE_ENV=development
NEXT_CACHE_COMPONENTS=true

# Database
# DATABASE_URL: pooled runtime URL (Supabase transaction pooler, typically port 6543)
# DIRECT_URL: direct URL for migrations (typically port 5432)
DATABASE_URL=your_database_url_here
DIRECT_URL=your_direct_database_url_here
DATABASE_HOST=your_database_host_here
POSTGRES_PRISMA_URL=your_postgres_prisma_url_here

# Whop Plan IDs
NEXT_PUBLIC_WHOP_MONTHLY_PLAN_ID=plan_55MGVOxft6Ipz
NEXT_PUBLIC_WHOP_6MONTH_PLAN_ID=plan_LqkGRNIhM2A2z
NEXT_PUBLIC_WHOP_YEARLY_PLAN_ID=plan_JWhvqxtgDDqFf
NEXT_PUBLIC_WHOP_LIFETIME_PLAN_ID=your_plan_id_here
NEXT_PUBLIC_WHOP_FREE_PLAN_ID=your_plan_id_here
NEXT_PUBLIC_WHOP_TEAM_PLAN_ID=your_plan_id_here

# Admin Configuration
ADMIN_USER_ID=your_admin_user_id_here
ALLOWED_ADMIN_USER_ID=your_comma_separated_admin_user_ids_here
ADMIN_EMAIL_DOMAINS=your_admin_email_domains_here

# Cron Job Security
CRON_SECRET=your_cron_secret_here
VERCEL_CRON_SECRET=your_vercel_cron_secret_here
UNSUBSCRIBE_TOKEN_SECRET=your_unsubscribe_token_secret_here_must_be_at_least_32_chars

# Prisma / Pool tuning
PG_POOL_MAX=5
PG_POOL_MIN=0
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECT_TIMEOUT_MS=10000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Legacy aliases still read by code paths
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
SUPABASE_WEBHOOK_SECRET=your_supabase_webhook_secret_here

# AI
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_BASE_URL=https://your-openai-compatible-endpoint
AI_MODEL_DEFAULT=your_default_model_here
AI_MODEL=your_default_model_alias_here
AI_MODEL_CHAT=your_chat_model_here
AI_MODEL_SUPPORT=your_support_model_here
AI_MODEL_EDITOR=your_editor_model_here
AI_MODEL_MAPPINGS=your_mappings_model_here
AI_MODEL_FORMAT_TRADES=your_format_trades_model_here
AI_MODEL_ANALYSIS=your_analysis_model_here
AI_MODEL_SEARCH=your_search_model_here
AI_TIMEOUT_MS=60000
AI_MAX_STEPS=10
AI_LOG_SAMPLE_RATE=0.25
AI_ROUTER_ENABLED=true
AI_ROUTER_PROVIDER_ORDER=openrouter
AI_ROUTER_MAX_PRICE_INPUT=0.05
AI_ROUTER_MAX_PRICE_OUTPUT=0.05
AI_ROUTER_BYOK_FREE_MODELS=
# Legacy router aliases kept for backwards compatibility
AI_ROUTER_MODEL_FREE=openrouter/free
AI_ROUTER_MODEL_AUTO=openrouter/auto
AI_ROUTER_MODEL_LIQUID=Liquid/lfm2-8b-a1b
AI_ROUTER_LIQUID_MODEL=Liquid/lfm2-8b-a1b

# Auth / OAuth
NEXT_PUBLIC_DISCORD_CONFIGURED=true
DISCORD_ID=your_discord_client_id_here
DISCORD_SECRET=your_discord_client_secret_here
NEXT_PUBLIC_GOOGLE_CONFIGURED=true
REDIRECT_URL=https://qunt-edge.vercel.app/api/auth/callback
TRADOVATE_REDIRECT_URI=http://localhost:3000/api/auth/callback
AUTH_MFA_ENFORCEMENT=false
# Legacy typo key currently present in Vercel envs; keep until migrated
UTH_MFA_ENFORCEMENT=false

# Security
ENCRYPTION_KEY=your_encryption_key_here
TOKEN_CRYPTO_KEY=your_32_plus_char_token_crypto_key_here
UNSUBSCRIBE_TOKEN_SECRET=your_unsubscribe_token_secret_here
WIDGET_MESSAGE_BUS_SECRET=your_widget_message_bus_secret_here
CSP_ENABLED=true
CSP_REPORT_ONLY=false
CSP_STRICT_MODE=true

# Email / Support
RESEND_API_KEY=your_resend_api_key_here
SUPPORT_TEAM_EMAIL=support@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
# Email sender addresses (reply-to for transactional emails)
WELCOME_REPLY_TO=team@yourdomain.com
WEEKLY_SUMMARY_REPLY_TO=team@yourdomain.com
TEAM_INVITE_FROM=Qunt Edge Team <team@yourdomain.com>
RENEWAL_NOTICE_REPLY_TO=team@yourdomain.com

# Marketing / public app URLs
NEXT_PUBLIC_SITE_URL=https://qunt-edge.vercel.app
NEXT_PUBLIC_APP_URL=https://qunt-edge.vercel.app
NEXT_PUBLIC_BASE_URL=https://qunt-edge.vercel.app
NEXT_PUBLIC_VERCEL_URL=https://your-project.vercel.app
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_DISCORD_INVITATION=https://discord.gg/your-invite-code
NEXT_PUBLIC_REPO_OWNER=your_repo_owner_here
NEXT_PUBLIC_REPO_NAME=your_repo_name_here
NEXT_PUBLIC_CACHE_DEBUG=false
NEXT_PUBLIC_ENABLE_PUBLIC_MOTION=true
NEXT_PUBLIC_ENABLE_SW=true
NEXT_PUBLIC_SW_ENABLED=true
NEXT_PUBLIC_UI_V2_ENABLED=
NEXT_PUBLIC_DISABLE_SERVICE_WORKERS=false
NEXT_PUBLIC_ENABLE_DEV_MOCK_TRADES=false
NEXT_PUBLIC_CACHE_REVALIDATE=
NEXT_PUBLIC_SENTRY_DSN=
HEALTH_DETAILS_PUBLIC=false
TOKEN_CRYPTO_KEY_VERSION=v1

# Tutorials / content
NEXT_PUBLIC_ONBOARDING_VIDEO_ID=your_video_id_here
NEXT_PUBLIC_ONBOARDING_VIDEO_ID_EN=your_video_id_here
NEXT_PUBLIC_ONBOARDING_VIDEO_ID_FR=your_video_id_here
