    "scripts": {
      "dev": "next dev",
      "clean:build-artifacts": "node scripts/clean-build-artifacts.mjs",
      "self-heal": "node scripts/self-heal.mjs",
      "prebuild": "npm run clean:build-artifacts && tsx scripts/generate-routes.ts",
      "db:sync": "node scripts/sync-stack.mjs",
      "build": "npm run db:sync && NODE_OPTIONS=--max-old-space-size=8192 NEXT_DISABLE_FONT_DOWNLOADS=1 NEXT_BUILD_CPUS=${NEXT_BUILD_CPUS:-1} node scripts/robust-next-build.mjs",
      "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
      "start:standalone": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
      "lint": "eslint",
      "typecheck": "npm run clean:build-artifacts && node scripts/robust-typecheck.mjs",
      "test": "vitest run --config vitest.config.ts",
      "test:smoke": "node scripts/smoke-http.mjs",
      "test:coverage": "vitest run --config vitest.config.ts --coverage",
      "loadtest:k6": "k6 run scripts/loadtest/k6-smoke.js",
      "check:route-budgets": "node scripts/check-route-budgets.mjs",
      "check:route-security": "node scripts/check-route-security.mjs",
      "check:dead-code": "node scripts/check-dead-code.mjs",
      "check:warning-budget": "node scripts/check-warning-budget.mjs",
      "check:color-contract": "node scripts/check-color-contract.mjs",
      "analyze:bundle": "node scripts/analyze-bundle.mjs",
      "perf:verify": "npm run check:route-budgets && npm run analyze:bundle",
      "postinstall": "prisma generate",
      "test:payment": "vitest run --config vitest.payment.config.ts",
      "test:payment:ui": "vitest --config vitest.payment.config.ts --ui",
      "test:payment:coverage": "vitest --config vitest.payment.config.ts --coverage",
      "perf:lighthouse": "node scripts/perf-lighthouse.mjs",
      "perf:dashboard-runtime": "node scripts/perf-dashboard-runtime.mjs",
      "perf:headers": "node scripts/perf-header-check.mjs",
      "perf:baseline": "node scripts/perf-baseline.mjs",
      "perf:capture-baseline": "node scripts/perf-capture-baseline.mjs",
      "perf:ci": "npm run check:dead-code && npm run check:route-security && npm run check:route-budgets && npm run analyze:bundle && PERF_HEADER_STRICT=true npm run perf:headers && npm run perf:baseline && npm run perf:dashboard-runtime && npm run perf:lighthouse"
    }
